# Slack app credentials. Keep these in .env; never commit real tokens.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_USER_TOKEN=xoxp-your-user-token
SLACK_SIGNING_SECRET=your-signing-secret
OWNER_SLACK_USER_ID=U1234567890

# Comma-separated IDs of public channels where the bot is a member.
# The bot reads only messages authored by OWNER_SLACK_USER_ID in these channels.
SLACK_CHANNEL_IDS=C1234567890,C0987654321
# Channel ID for #scrapbook. The user token's owner must be a member.
SCRAPBOOK_CHANNEL_ID=C1234567890

GITHUB_USERNAME=abdulgafarabdurrasheed
HACKATIME_USERNAME=your-hackatime-username
SCRAPBOOK_USERNAME=abdulgafarabdurrasheed
TIMEZONE=Africa/Lagos

# OpenAI-compatible endpoint. Put one or more user-owned keys in rotation order.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_API_KEYS=replace-with-your-key

HOST=127.0.0.1
PORT=3000
DATABASE_PATH=data/drafts.sqlite3
